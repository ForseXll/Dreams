{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API for Dreams e-commerce",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file .env --import tsx src/index.ts",
    "start": "node --env-file .env --import tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --env-file .env --import tsx src/scripts/seed-permissions.ts",
    "cloudinary:list-urls": "node --env-file .env --import tsx src/scripts/list-cloudinary-urls.ts",
    "openapi:export": "tsx src/scripts/export-openapi.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.29.3",
    "fastify": "^5.7.4",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.8",
    "postgres": "^3.4.3",
    "stripe": "^14.14.0",
    "tsx": "^4.7.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.5",
    "@types/nodemailer": "^6.4.14",
    "drizzle-kit": "^0.21.4",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.8.3"
  }
}
